# Copy to .env and fill in from Firebase Console > Project settings > General.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Flask, for per-class grades and attendance only -- the guardian code,
# linking and dashboard read Firestore and need no server.
# On an Android emulator 10.0.2.2 is the HOST machine; "localhost" is the
# emulator itself, which is why the old value could never reach Flask.
EXPO_PUBLIC_API_URL=
